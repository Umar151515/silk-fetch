# Telegram API
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here

# PostgreSQL
DB_USER=user
DB_PASSWORD=password
DB_NAME=dbname
TEST_DB_NAME=test_dbname

DATABASE_URL=postgresql+psycopg://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}
TEST_DATABASE_URL=postgresql+psycopg://${DB_USER}:${DB_PASSWORD}@db_dev:5432/${TEST_DB_NAME}

# Redis
REDIS_PASSWORD=password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
TEST_REDIS_URL=redis://:${REDIS_PASSWORD}@redis_dev:6379/0

# Application Settings
TARGET_CHANNEL=silkroadcargo
DEBUG=true